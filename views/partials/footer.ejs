    <% const _cl = (typeof contentLang !== 'undefined' && contentLang === 'ar') ? 'ar' : 'en'; %>
    <div class="lang-switch" title="Which language you are editing">
      <a href="?content_lang=en" class="<%= _cl === 'en' ? 'on' : '' %>">English</a>
      <a href="?content_lang=ar" class="<%= _cl === 'ar' ? 'on' : '' %>" lang="ar">العربية</a>
    </div>
    <style>
      .lang-switch { display:inline-flex; border:1px solid var(--border); border-radius:10px; overflow:hidden; margin-left:6px; }
      .lang-switch a { padding:7px 12px; font-size:12px; font-weight:700; color:var(--grey); }
      .lang-switch a.on { background:var(--blue); color:#fff; }
      .lang-banner { padding:12px 16px; border-radius:10px; margin-bottom:20px; font-size:13px; font-weight:600; line-height:1.6;
                     background:rgba(252,156,68,0.1); border:1px solid rgba(252,156,68,0.25); color:var(--orange); }
      .lang-banner strong { color:#fff; }
    </style>
    </div><!-- /.topbar-actions -->
  </div><!-- /.topbar -->
  <div class="content">
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success[0] %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><i class="fas fa-circle-exclamation"></i> <%= error[0] %></div>
    <% } %>
    <% if (_cl === 'ar') { %>
      <div class="lang-banner"><i class="fas fa-language"></i>
        <strong>You're editing the Arabic version (العربية).</strong>
        Empty fields fall back to English. Images, links, status and order are shared with English —
        change those in English mode. Creating or deleting an item affects both languages.
      </div>
    <% } %>
